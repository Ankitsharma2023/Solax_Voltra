# Copy to .env and fill in. Never commit .env.

# SolaX Developer Portal → Application → Authorization (base URL: avatar → My account → call URL)
SOLAX_BASE_URL=https://openapi-in.solaxcloud.com
SOLAX_CLIENT_ID=
SOLAX_CLIENT_SECRET=
PORT=4300

# MongoDB (accounts, partners, push subscriptions, per-plant settings). Empty = JSON files in data/ (local only).
# Atlas: user with readWrite on the voltra_app database only.
MONGODB_URI=mongodb+srv://voltra_app:PASSWORD@cluster0.xxxxx.mongodb.net/voltra_app?retryWrites=true&w=majority

# Inverter control (work mode etc). Keep false unless the SolaX app has control permissions.
SOLAX_ALLOW_CONTROL=false

# Web push (generate: node -e 'console.log(require("web-push").generateVAPIDKeys())')
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://voltra.in

# Signs login cookies (generate: node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))')
SESSION_SECRET=

# Voltra's own Organization Number (distributors under Voltra enter this at sign-up)
VOLTRA_ORG_NO=VLT000001

# Email for verification codes (any SMTP). Empty SMTP_HOST = codes printed in the server log (local only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Voltra Energy <no-reply@voltra.in>"
